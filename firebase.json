{
  "hosting": {
    "target": "insert-coin-app",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "charla_5_juegos/**",
      "tools/**",
      "scratch_*.js"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      }
    ]
  }
}
